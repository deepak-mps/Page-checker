PORT=4000

# --- Email alerts via SendGrid ---
# 1. Get your SendGrid API key: Settings > API Keys > Create API Key (Full Access or
#    "Mail Send" restricted access is enough).
# 2. Verify a sender: Settings > Sender Authentication > verify a single sender (or a full
#    domain). SENDGRID_FROM must be that verified address, or SendGrid will reject sends.
# 3. Fill in both values below, then turn on "Email sending" on the Recipients screen.
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=your-verified-sender@example.com

# Without SENDGRID_API_KEY set, sends log to the console instead of actually going out —
# the app still runs fine without credentials configured.

# --- Optional: Cloudflare bypass header ---
# Only useful once devops sets up a matching Cloudflare WAF Custom Rule on the target zone
# that skips bot-check challenges (Bot Fight Mode / Managed Rules) when this exact header
# name+value is present. Both vars must be set for the header to be sent — leave both unset
# if you don't have such a rule yet (the app runs fine without this, just retries and flags
# CLOUDFLARE_CHALLENGE as before). HTTP header names are case-insensitive, but the Cloudflare
# rule expression should match whatever case you configure here — lowercase is the convention.
# Generate CF_BYPASS_HEADER_VALUE as a long random secret (32+ chars) — never a guessable
# value — since anyone who obtains it gets the same Cloudflare bypass. Put the real value in
# your local .env only (gitignored) — this .env.example file IS committed to git, so it
# should stay a placeholder, never the actual secret.
# CF_BYPASS_HEADER_NAME=x-pagechecker-secret
# CF_BYPASS_HEADER_VALUE=replace-with-your-own-long-random-secret-token
